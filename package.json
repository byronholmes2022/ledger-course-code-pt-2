{
  "name": "ledger",
  "version": "0.1.0",
  "description": "Personal finance tracker - transaction ledger, account balances, budgets and insights",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate:up": "dotenv -- node-pg-migrate up --migrations-dir src/db/migrations",
    "migrate:down": "dotenv -- node-pg-migrate down --migrations-dir src/db/migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations",
    "seed": "node src/db/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
